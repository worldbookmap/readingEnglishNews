# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role key (server only — never expose)

# Password for the app's login screen (leave empty locally to disable the gate)
APP_PASSWORD=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/fetch-articles
CRON_SECRET=some-long-random-string

# Optional: how many popular articles to save per site each day (default 5)
ARTICLES_PER_SOURCE=5
